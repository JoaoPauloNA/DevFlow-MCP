{
  "schema_version": 1,
  "default_fallback_on": [
    "PROVIDER_UNAVAILABLE",
    "RATE_LIMITED",
    "TIMEOUT",
    "INVALID_JSON",
    "HTTP_ERROR"
  ],
  "connections": {
    "primary-gateway": {
      "type": "openai-compatible",
      "base_url": "http://127.0.0.1:8321/v1",
      "auth": {
        "type": "env",
        "env": "CLIPROXY_API_KEY"
      },
      "quota_group": "primary",
      "enabled": true,
      "timeout": 180
    },
    "backup-gateway": {
      "type": "openai-compatible",
      "base_url": "http://127.0.0.1:8311/v1",
      "auth": {
        "type": "env",
        "env": "CLIPROXY_BACKUP_KEY"
      },
      "quota_group": "backup",
      "enabled": true,
      "timeout": 180
    }
  },
  "roles": {
    "ENGINEER": {
      "strategy": "sequential",
      "candidates": [
        {
          "id": "engineer-primary",
          "connection": "primary-gateway",
          "model": "gpt-5.6-terra-medium",
          "enabled": true,
          "technical_retries": 1
        },
        {
          "id": "engineer-backup",
          "connection": "backup-gateway",
          "model": "gpt-5.6-sol-medium",
          "enabled": true,
          "technical_retries": 1
        }
      ]
    },
    "DEV:FRONTEND:SIMPLE": {
      "strategy": "sequential",
      "candidates": [
        {
          "id": "dev-fe-simple-primary",
          "connection": "primary-gateway",
          "model": "gemini-3.7-flash-high",
          "enabled": true,
          "technical_retries": 1
        },
        {
          "id": "dev-fe-simple-backup",
          "connection": "backup-gateway",
